    }
    value(4; "Approval Created")
    {
    Caption = 'Approval Created';
    }
    value(5; "Approval Open")
    {
    Caption = 'Approval Open';
    }
    value(6; "Approval Rejected")
    {
    Caption = 'Approval Rejected';
    }
    value(7; "Approved")
    {
    Caption = 'Approved';
    }
    value(8; "Approval Canceled")
    {
    Caption = 'Approval Cancelled';
    // Caption = 'Approval Cenceled';
    }
